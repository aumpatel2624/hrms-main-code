# ============ DATABASE ============
DATABASE="mongodb+srv://user:password@cluster.mongodb.net/demo-panel"

# Optional shared query cache. The server falls back to MongoDB if Redis is unavailable.
REDIS_URL="redis://localhost:6379"

# ============ SERVER ============
PORT=7001
# On a server this MUST be `production`. Production (ADR-067):
#   - refuses to start without a real SESSION_SECRET (below);
#   - allows only ALLOWED_ORIGINS for CORS — `development` allows ANY origin
#     with cookies, so never deploy with `development`;
#   - turns off mongoose query logging (it prints password hashes);
#   - turns off /api-docs unless API_DOCS_ENABLED=true;
#   - sends the session cookie over HTTPS only and trusts one proxy hop (nginx).
NODE_ENV=development

# ============ SESSION ============
# Auth is cookie/session based (express-session + MongoDB store), no JWTs.
# Anyone who knows this value can forge a signed-in cookie. In production the
# server will not start unless it is at least 32 characters and not this
# example value. Generate it on the server, never in a commit:
#   openssl rand -hex 32
SESSION_SECRET="change-me"

# ============ API DOCS ============
# /api-docs (Swagger UI with a "Try it out" console) and /api-docs.json are on
# in development and OFF in production. Set to true only to turn them on in
# production deliberately.
# API_DOCS_ENABLED=false

# ============ SEED (npm run seed) ============
SEED_ADMIN_NAME="Super Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_ADMIN_MOBILE="9999999999"
# Load the 195 org-chart employees on `npm run seed` (off by default, ADR-041).
# SEED_ORG_CHART_EMPLOYEES=true

# ============ CORS ============
# Comma-separated list of allowed origins.
#
# REQUIRED IN PRODUCTION, including a same-origin deployment: browsers send an
# Origin header on stylesheet and preflight requests, so a site whose own origin
# is missing here has its CSS blocked and renders as a blank page. Only
# localhost is allowed by default.
# ALLOWED_ORIGINS=https://panel.example.com

# ============ PUBLIC URLS ============
# Absolute origin of this server, used to build URLs for uploaded images so
# social crawlers can fetch them. Falls back to the request's own host if unset.
# REACT_APP_API_URL=http://localhost:7001
